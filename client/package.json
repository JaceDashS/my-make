{
  "name": "MyMake",
  "version": "0.0.1",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "sync:dev-host": "node scripts/sync-dev-host.mjs",
    "android": "react-native run-android",
    "android:apk": "npm run sync:dev-host && cd android && gradlew.bat assembleDebug",
    "android:apk:release": "npm run sync:dev-host && cd android && gradlew.bat assembleRelease",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "test:classes-render": "jest --runTestsByPath __tests__/teacher-reservation-approval-section.test.tsx __tests__/student-reservation-section.test.tsx __tests__/teacher-available-schedule.mobile.test.tsx __tests__/student-account-section-v2.mobile.test.tsx __tests__/teacher-preset-section.test.tsx --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.electron.main.json",
    "preandroid": "npm --prefix .. run icons:generate && npm run sync:dev-host",
    "prestart": "npm run sync:dev-host",
    "start": "react-native start",
    "test": "jest",
    "electron:compile-main": "npm --prefix .. run icons:generate && tsc -p tsconfig.electron.main.json",
    "electron:dev:renderer": "webpack serve --config webpack.electron.js --mode development",
    "electron:build": "npm run electron:compile-main && webpack --config webpack.electron.js --mode production && electron-builder --config electron-builder.json",
    "electron:run": "npm run electron:compile-main && webpack --config webpack.electron.js --mode production && node scripts/run-electron.js dist-electron/electron/main.js"
  },
  "dependencies": {
    "@react-native/new-app-screen": "^0.82.0",
    "clipper-lib": "^6.4.2",
    "martinez-polygon-clipping": "^0.8.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-native": "^0.82.0",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "^0.82.0",
    "@react-native/eslint-config": "^0.82.0",
    "@react-native/metro-config": "^0.82.0",
    "@react-native/typescript-config": "^0.82.0",
    "@rnx-kit/jest-preset": "^0.1.17",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "electron": "^35.1.2",
    "electron-builder": "^26.8.1",
    "eslint": "^8.19.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "^19.1.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.5",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.1"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
