{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "dist-electron",
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src-web/**/*", "src/**/*", "src-shared/**/*", "electron/**/*"]
}
